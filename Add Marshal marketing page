<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  // mobile menu (simple show/hide of nav links)
  const toggle = document.getElementById('menuToggle');
  const navLinks = document.querySelector('.nav-links');
  toggle.addEventListener('click', () => {
    const open = navLinks.style.display === 'flex';
    navLinks.style.display = open ? 'none' : 'flex';
    navLinks.style.cssText += 'flex-direction:column; position:absolute; top:64px; left:0; right:0; background:#0a0a0f; padding:20px 28px; border-bottom:1px solid #242236; gap:16px;';
  });

  // hero mock — cycles through an illustrative push/test/deploy run (dummy data)
  const steps = [
    {
      call: 'marshal.push_code(files, "main")', target: 'GITHUB', verdict: 'passed', label: 'Pushed',
      body: 'Opened PR #482 on acme/storefront\n3 files changed, 1 commit'
    },
    {
      call: 'marshal.run_tests()', target: 'RUNNER', verdict: 'running', label: 'Running…',
      body: '$ npm test\n  ✓ checkout flow (14 passed)\n  ✓ inventory sync (6 passed)'
    },
    {
      call: 'marshal.run_tests()', target: 'RUNNER', verdict: 'passed', label: 'Tests passed',
      body: '$ npm test\n  20 passed, 0 failed — 4.1s'
    },
    {
      call: 'marshal.deploy("vercel")', target: 'VERCEL', verdict: 'live', label: 'Live',
      body: 'Deployed storefront-prod\nhttps://storefront.acme.com'
    },
  ];

  const mockCards = document.getElementById('mockCards');
  let idx = 0;

  function renderCard(){
    const s = steps[idx];
    mockCards.innerHTML = `
      <div class="mock-card">
        <div class="mock-card-top">
          <div>
            <div class="mock-target">${s.target}</div>
            <div class="mock-call">${s.call}</div>
          </div>
          <span class="verdict ${s.verdict}">${s.label}</span>
        </div>
        <div class="mock-body">${s.body}</div>
      </div>
    `;
