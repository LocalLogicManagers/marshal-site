    font-family:var(--font-mono); font-size:13px; color:var(--text-muted);
    border:1px solid var(--border); background:var(--bg-card); padding:7px 14px; border-radius:100px;
  }

  /* how it works */
  .steps{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
  .step{background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:26px 22px;}
  .step .n{font-family:var(--font-mono); font-size:13px; font-weight:700; color:var(--accent);}
  .step h3{font-size:17px; margin-top:14px; font-weight:600;}
  .step p{font-size:14px; color:var(--text-muted); margin-top:10px;}
  .step .call{margin-top:14px; font-family:var(--font-mono); font-size:11.5px; color:var(--text-dim); background:var(--bg-elevated); border:1px solid var(--border); border-radius:8px; padding:8px 10px; overflow-x:auto; white-space:nowrap;}

  /* feature grid */
  .features{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
  .feature{background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:28px;}
  .feature .icon{
    width:38px; height:38px; border-radius:10px; background:var(--accent-soft);
